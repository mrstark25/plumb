# Privy app id — enables email, social and embedded-wallet login alongside
# browser wallets. Public by design (it ships in the bundle), which is why it
# carries the NEXT_PUBLIC prefix. Get one at https://dashboard.privy.io
# Leave blank and Liberty falls back to browser-wallet discovery only.
NEXT_PUBLIC_PRIVY_APP_ID=

# Groq — powers intent parsing and DeFi Q&A. Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Groq retires hosted models periodically; if chat starts failing,
# check https://console.groq.com/docs/models and set a current id here.
# Default: openai/gpt-oss-120b
GROQ_MODEL=

# Optional. Uniswap Trading API key. Without it Liberty falls back to the
# configured public swap aggregator. Free key: https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=

# Optional. LI.FI works unauthenticated; a key only raises rate limits.
LIFI_API_KEY=

# Optional but recommended. Prices work without it, but the keyless CoinGecko
# tier is a few calls per minute and rate-limits readily; Liberty then falls
# back to DefiLlama. A free Demo key raises the limit substantially:
# https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=

# Optional. The Graph gateway API key, from https://thegraph.com/studio
# Enables subgraph-backed token safety checks and portfolio history. Without
# it those tools are unavailable and Liberty falls back to refusing unknown
# tokens rather than verifying them.
GRAPH_API_KEY=

# Optional RPC overrides. Defaults are public endpoints and are rate-limited —
# set your own (Alchemy/Infura/QuickNode) before doing anything real.
RPC_URL_1=
RPC_URL_8453=
RPC_URL_42161=
RPC_URL_137=
RPC_URL_4663=

# Set to "true" ONLY when deployed behind a proxy that overwrites
# X-Forwarded-For. Left unset, rate limiting uses a single shared bucket,
# because an attacker could otherwise mint a fresh bucket per request.
TRUST_PROXY_HEADERS=

# Optional. Hyperliquid builder code — a registered builder address that
# receives a fee on orders placed through this app. Leave blank and no builder
# code is attached (orders still work). Fee is in tenths of a basis point;
# 10 = 0.01%, capped at 100 (0.1%) by Hyperliquid.
HYPERLIQUID_BUILDER_ADDRESS=
HYPERLIQUID_BUILDER_FEE_TENTHS_BP=10
